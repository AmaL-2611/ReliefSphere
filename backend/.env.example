# ReliefSphere Backend — Environment Variables
# Copy this file to .env and fill in real values. DO NOT commit .env to source control.

# Server
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/reliefsphere

# JWT — use a long, random string (e.g. openssl rand -hex 64)
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET

# Google OAuth (get from Google Cloud Console)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Email (Gmail App Password — generate at myaccount.google.com/apppasswords)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# Frontend URL (used for password-reset links and approval email links)
CLIENT_URL=http://localhost:3000

# Optional: AI Description Understanding (Optional - system falls back to rule-based NLP if omitted)
# GEMINI_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key
